# Cellhive environment (SPEC §20). Copy to `.env` and adjust.
#
# The values below work for local development against `pnpm dev:infra`
# (docker-compose.dev.yml). Every variable of SPEC §20 is listed; a unit test in
# packages/server-core keeps this file and the zod schema in sync. An empty value
# means "unset" and falls back to the default shown in the comment.
#
# !!! Values marked DEV-ONLY are public placeholders. Generate your own for any
# !!! real deployment; the commands are given next to each secret.

# --- Runtime ------------------------------------------------------------------
# production | development | test (default: production)
NODE_ENV=development
# api | worker | all | migrate (default: api)
MODE=all
# HTTP port of the api (default: 3000)
PORT=3000
# Required. Root URL users open in the browser (invite/reset/share links, default CORS origin).
PUBLIC_URL=http://localhost:5173

# --- PostgreSQL 18 ------------------------------------------------------------
# Required. DEV-ONLY credentials (docker-compose.dev.yml).
DATABASE_URL=postgres://cellhive:cellhive@localhost:5432/cellhive
# default: 10
DATABASE_POOL_MAX=10

# --- Valkey (redis:// or rediss://) -------------------------------------------
# Required.
CACHE_URL=redis://localhost:6379

# --- File storage (ADR-0016) --------------------------------------------------
# local | s3 (default: local)
STORAGE_DRIVER=s3
# Directory for STORAGE_DRIVER=local (default: /data/files)
STORAGE_LOCAL_PATH=./data/files
# Required when STORAGE_DRIVER=s3 (except S3_ENDPOINT: empty = AWS S3).
# Dev values point at the Garage container of docker-compose.dev.yml.
S3_ENDPOINT=http://localhost:3900
S3_REGION=garage
S3_BUCKET=cellhive
# DEV-ONLY key. Garage format: `GK` + 24 hex chars / 64 hex chars:
#   echo "GK$(openssl rand -hex 12)"   /   openssl rand -hex 32
S3_ACCESS_KEY_ID=GK6465762d6f70656e62617365
S3_SECRET_ACCESS_KEY=6465762d6f6e6c792d73332d7365637265742d646f2d6e6f742d757365212121
# default: true (required by Garage and most self-hosted S3 servers)
S3_FORCE_PATH_STYLE=true
# Endpoint browsers use for presigned upload/download URLs (default: S3_ENDPOINT).
# Must be reachable by clients, e.g. https://files.example.com reverse-proxied to
# Garage. Not a sub-path of PUBLIC_URL: SigV4 signatures cover host and path.
# docker-compose also hands it to the web container (STORAGE_PUBLIC_ORIGIN), whose
# Content-Security-Policy then lets browsers upload to and load files from it.
S3_PUBLIC_ENDPOINT=

# --- Secrets --------------------------------------------------------------------
# Required. Exactly 32 bytes, base64. Encrypts meta.secrets (AES-256-GCM).
# DEV-ONLY value. Generate: openssl rand -base64 32
# Losing or changing it makes stored integration secrets unreadable.
APP_MASTER_KEY=ZGV2LW9ubHktbWFzdGVyLWtleS1kby1ub3QtdXNlISE=
# Required. At least 32 bytes. HMAC for CSRF tokens and local-storage signed URLs.
# DEV-ONLY value. Generate: openssl rand -base64 32
SESSION_SECRET=dev-only-session-secret-do-not-use-in-production

# --- HTTP -----------------------------------------------------------------------
# auto | true | false (default: auto = Secure when the request arrived over HTTPS)
COOKIE_SECURE=auto
# Comma-separated IPs/CIDRs whose X-Forwarded-* headers are trusted
# (default: 127.0.0.0/8,::1/128,172.16.0.0/12 = loopback + Docker networks)
TRUSTED_PROXIES=127.0.0.0/8,::1/128,172.16.0.0/12
# Comma-separated origins allowed by CORS (default: origin of PUBLIC_URL)
CORS_ORIGINS=

# --- Sign-in with OIDC (SPEC §20, ADR-36 §3; empty = password sign-in only) -----
# Comma-separated provider slugs (a-z, 0-9, -; at most 10). Each slug is set up by
# OIDC_<SLUG>_* below (slug upper-cased, "-" becomes "_"). Register the redirect URI
# <PUBLIC_URL>/api/v1/auth/oidc/<slug>/callback at the identity provider.
OIDC_PROVIDERS=
# Example for a slug `keycloak`:
# Required. Issuer URL (https://; http:// only with NODE_ENV=development).
# OIDC_KEYCLOAK_ISSUER=https://sso.example.com/realms/acme
# Required. Confidential client (client_secret_basic).
# OIDC_KEYCLOAK_CLIENT_ID=cellhive
# OIDC_KEYCLOAK_CLIENT_SECRET=
# Button label (default: the slug)
# OIDC_KEYCLOAK_NAME=Keycloak
# Space-separated scopes, must include openid (default: openid email profile)
# OIDC_KEYCLOAK_SCOPES=openid email profile
# true creates an account for an unknown user whose email the provider verified
# (default: false)
# OIDC_KEYCLOAK_ALLOW_SIGNUP=false
# Comma-separated email domains new accounts may have (default: any)
# OIDC_KEYCLOAK_ALLOWED_DOMAINS=example.com
# true links to an existing account with the same verified email (default: false;
# enable only for a provider that verifies emails it does not own)
# OIDC_KEYCLOAK_LINK_BY_EMAIL=false
# Slug of the organization new accounts join as member (default: none)
# OIDC_KEYCLOAK_AUTO_JOIN_ORG=

# --- Email (empty SMTP_URL = email disabled) ------------------------------------
# e.g. smtp://user:pass@smtp.example.com:587 or smtps://…:465
SMTP_URL=
# Required when SMTP_URL is set, e.g. Cellhive <no-reply@example.com>
SMTP_FROM=
# Comma-separated domains the SMTP server may send as (sender identities `send_as`;
# the relay must sign DKIM for them). Default: the domain of SMTP_FROM.
SMTP_ALLOWED_FROM_DOMAINS=
# true accepts plain SMTP without STARTTLS (local development only; default: false =
# smtps:// or STARTTLS required)
SMTP_ALLOW_INSECURE=false
# Automation and notification emails per organization per hour (default: 500)
EMAIL_MAX_PER_HOUR_PER_ORG=500
# Recipients (to + cc + bcc) of one email, at most 500 (default: 50)
EMAIL_MAX_RECIPIENTS=50
# Emails per second sent by one api/worker process (default: 5)
SMTP_MAX_PER_SEC=5
# "Test connection" / test emails per user per minute (default: 5)
EMAIL_TEST_SEND_PER_MIN=5
# Largest HTML part of an email in bytes (default: 102400; Gmail clips around 102 KB)
EMAIL_MAX_HTML_BYTES=102400
# true lets sender identities use their own SMTP server on a private/LAN address
# (e.g. a self-hosted mail.example.lan); cloud metadata addresses stay blocked (default: false)
SMTP_ALLOW_PRIVATE_HOSTS=false
# Emails per hour sent through one sender identity's own SMTP server (default: 100)
EMAIL_MAX_PER_HOUR_PER_IDENTITY=100
# Footer of automation emails: required = always a footer (minimal or full) in every
# organization; org = each organization may let automations sent by a verified
# identity of its own domain drop it (single-organization instances) (default: required)
EMAIL_AUTOMATION_FOOTER=required
# Files of one automation email, 1-20; organizations may set a lower value (default: 10)
EMAIL_MAX_ATTACHMENTS=10
# Original bytes of those files in all, 1 MiB-30 MiB; organizations may set a lower value
# (default: 15728640 = 15 MiB; base64 makes the email about a third larger)
EMAIL_MAX_ATTACHMENT_BYTES=15728640
# Images embedded in one automation email (signature included), 1-20; their bytes count
# toward EMAIL_MAX_ATTACHMENT_BYTES (default: 5)
EMAIL_MAX_INLINE_IMAGES=5

# --- Outbound HTTP of automations ------------------------------------------------
# org = an organization's HTTP allowlist entry lets automations reach private
# addresses of that host (an internal n8n); off = entries only allow another port
# on a public host — use off when organizations sharing this instance do not trust
# each other. Cloud metadata addresses are never reachable (default: org)
HTTP_PRIVATE_ALLOWLIST=org

# --- Incoming webhooks ------------------------------------------------------------
# Highest requests/s a base admin may give one incoming webhook (burst 4x;
# every base is also capped at 50 requests/s) (default: 50)
WEBHOOK_MAX_RATE_PER_SEC=50

# --- Defaults for new organisations --------------------------------------------
# BCP 47 locale (default: en)
DEFAULT_LOCALE=en
# IANA time zone (default: UTC)
DEFAULT_TIMEZONE=UTC
# ISO 4217 currency (default: USD)
DEFAULT_CURRENCY=USD
# true lets any signed-in user create an organisation through the API (default: false)
ALLOW_ORG_CREATION=false

# --- Limits -----------------------------------------------------------------------
# ADR-0020 (default: 500)
MAX_FIELDS_PER_TABLE=500
# Formula and lookup fields per base, SPEC §9.5 (default: 200)
COMPUTED_FIELDS_MAX_PER_BASE=200
# ADR-0023 (default: 365; 0 = keep forever)
AUDIT_RETENTION_DAYS=365
# ADR-0029: notifications older than this are deleted (default: 90)
NOTIFICATION_RETENTION_DAYS=90
# Most rows of one table export; more → 422 before streaming (default: 1000000)
EXPORT_MAX_ROWS=1000000
# Largest attachment upload in bytes (default: 104857600 = 100 MB; at most 5 GiB)
ATTACHMENT_MAX_FILE_BYTES=104857600
# ADR-0018 (default: 5)
AUTOMATION_MAX_RUNNING_PER_ORG=5
# ADR-0026: runs one automation creates per batch (request/import/run); the rest is one
# skipped run (default: 1000, at most 50000)
AUTOMATION_MAX_RUNS_PER_BATCH=1000
# Finished automation runs (run log) older than this are deleted (default: 90, 1–3650)
AUTOMATION_RUN_RETENTION_DAYS=90
# default: 5
WORKER_CONCURRENCY=5

# --- Observability (SPEC §19) -------------------------------------------------------
# fatal | error | warn | info | debug | trace | silent (default: info)
LOG_LEVEL=info
# Bearer token for /metrics, at least 32 bytes (openssl rand -base64 32). Empty = no token.
METRICS_TOKEN=
# Serve /metrics on this internal port instead. Empty = not bound.
METRICS_PORT=
# OTLP endpoint for OpenTelemetry traces. Empty = disabled (no telemetry by default).
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- docker-compose.yml only (self-hosting; not read by the application) -----------
# Uncomment in your `.env` when running docker-compose.yml. That file sets
# DATABASE_URL, CACHE_URL, STORAGE_* and S3_ENDPOINT/REGION/BUCKET itself.
# Required, URL-safe characters only. Generate: openssl rand -hex 24
# POSTGRES_PASSWORD=
# Profile `full`. Generate: openssl rand -hex 32
# GARAGE_RPC_SECRET=
# Profile `full`. Generate: openssl rand -base64 32
# GARAGE_ADMIN_TOKEN=
# Image tag (default: latest)
# CELLHIVE_VERSION=latest
# Host port of the web container (default: 8080)
# HTTP_PORT=8080

# --- docker-compose.dev.yml only (`pnpm dev:infra`; not read by the application) ----
# Uncomment to run several checkouts/worktrees side by side. Each needs its own
# Compose project name (otherwise `dev:infra:down` of one deletes the other's
# volumes) and its own host ports; keep DATABASE_URL, CACHE_URL and S3_ENDPOINT
# above in sync with the ports.
# Compose project name: prefixes containers and volumes (default: cellhive-dev)
# COMPOSE_PROJECT_NAME=cellhive-dev
# Host port of PostgreSQL (default: 5432)
# DEV_POSTGRES_PORT=5432
# Host port of Valkey (default: 6379)
# DEV_VALKEY_PORT=6379
# Host port of the Garage S3 API (default: 3900)
# DEV_GARAGE_S3_PORT=3900
# Host port of the Garage admin API (default: 3903)
# DEV_GARAGE_ADMIN_PORT=3903

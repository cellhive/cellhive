# Headers of the share pages `/s/*` (SPEC §15A.3): the security headers of
# security-headers.conf, except Referrer-Policy (no-referrer, so the token in
# the URL never leaks to other sites), plus X-Robots-Tag (never indexed).
# Must match SHARE_PAGE_HEADERS in apps/web/security-headers.ts; a unit test
# compares them. A template like security-headers.conf.template
# (${STORAGE_PUBLIC_ORIGIN}).
add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob: ${STORAGE_PUBLIC_ORIGIN}; media-src 'self' blob: ${STORAGE_PUBLIC_ORIGIN}; font-src 'self' data:; connect-src 'self' ${STORAGE_PUBLIC_ORIGIN}; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
add_header X-Content-Type-Options "nosniff" always;
add_header X-Frame-Options "DENY" always;
add_header Referrer-Policy "no-referrer" always;
add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()" always;
add_header Cross-Origin-Opener-Policy "same-origin" always;
add_header X-Robots-Tag "noindex, nofollow" always;

{
  "name": "@cellhive/field-types",
  "version": "0.0.0",
  "private": true,
  "description": "Field type registry for Cellhive: options schemas, PostgreSQL types, validation, typecast, storage mapping and text formatting",
  "license": "AGPL-3.0-only",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@cellhive/contracts": "workspace:*",
    "zod": "^4.6.5"
  }
}

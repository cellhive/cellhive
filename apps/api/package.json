{
  "name": "@cellhive/api",
  "version": "0.0.0",
  "private": true,
  "description": "Cellhive HTTP API (NestJS on Fastify)",
  "license": "AGPL-3.0-only",
  "type": "module",
  "main": "./dist/main.js",
  "bin": {
    "cellhive": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "db:migrate": "MODE=migrate tsx --env-file-if-exists=../../.env src/main.ts",
    "cellhive": "tsx --env-file-if-exists=../../.env src/cli.ts",
    "seed:demo": "tsx --env-file-if-exists=../../.env src/seed.ts",
    "seed:bench": "tsx --env-file-if-exists=../../.env src/seed-bench.ts",
    "bench:records": "tsx --env-file-if-exists=../../.env scripts/bench-record-query.ts",
    "bench:export": "tsx --expose-gc --env-file-if-exists=../../.env scripts/bench-export.ts",
    "dev": "tsx watch --clear-screen=false --env-file-if-exists=../../.env src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:int": "vitest run -c vitest.int.config.ts",
    "test:matrix": "tsx scripts/permission-matrix.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.1",
    "@nestjs/common": "^12.1.0",
    "@nestjs/core": "^12.1.0",
    "@nestjs/platform-fastify": "^12.1.0",
    "@node-rs/argon2": "^2.2.1",
    "@cellhive/contracts": "workspace:*",
    "@cellhive/field-types": "workspace:*",
    "@cellhive/filter-dsl": "workspace:*",
    "@cellhive/markdown": "workspace:*",
    "@cellhive/permissions": "workspace:*",
    "@cellhive/server-core": "workspace:*",
    "@cellhive/worker": "workspace:*",
    "@modelcontextprotocol/server": "2.4.0",
    "busboy": "^1.6.0",
    "fastify": "^5.12.5",
    "ioredis": "^6.0.0",
    "kysely": "^0.29.6",
    "openid-client": "^6.8.8",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ws": "^8.21.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@modelcontextprotocol/client": "2.4.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/busboy": "^1.5.4",
    "@types/node": "^24.13.6",
    "@types/pg": "^8.23.1",
    "@types/smtp-server": "^3.5.13",
    "@types/ws": "^8.18.1",
    "hucre": "1.1.0",
    "pg": "^8.23.0",
    "smtp-server": "^3.19.13",
    "testcontainers": "^12.1.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.1"
  }
}
